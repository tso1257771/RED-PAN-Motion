# Byte-compiled / caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/
.env

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp
.ipynb_checkpoints/

# Local training data and run outputs
# Anchored to the repo root: an unanchored "data/" also ignored the
# redpan_motion/data/ package sources (dataset.py etc.).
/data/
logs/
runs/
wandb/
experiment/
*.h5
*.mseed
*.sac

# Generated inference products & plots (regenerate via scripts/)
continuous_outputs/
outputs/
debug_plot/
plots/
*.png

# Large external station inventory (~680 MB; obtain separately).
# scripts/picks_to_csv.py reads metadata/stationxml/ at runtime.
# Anchored to the repo root, so only the top-level metadata/ is ignored.
/metadata/

# checkpoints/ is tracked for the three released models only: each
# checkpoints/<model>/ holds best.pt and config.json (edge_rp90 also final.pt).
# Everything else under checkpoints/ stays local.
checkpoints/*
!checkpoints/redpan_60s/
!checkpoints/redpan_motion/
!checkpoints/edge_rp90/
checkpoints/**/*.log
checkpoints/*/epoch_*/
checkpoints/**/epoch_*.pt
checkpoints/**/best_total.pt
