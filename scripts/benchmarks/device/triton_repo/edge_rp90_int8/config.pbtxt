name: "edge_rp90_int8"
platform: "onnxruntime_onnx"
# The export has a fixed batch of 1, so batching is off and dims are given in full.
max_batch_size: 0
input [
  { name: "x",     data_type: TYPE_FP32, dims: [ 1, 3, 9000 ] },
  { name: "z_raw", data_type: TYPE_FP32, dims: [ 1, 1, 9000 ] }
]
output [
  { name: "picker",   data_type: TYPE_FP32, dims: [ 1, 3, 9000 ] },
  { name: "polarity", data_type: TYPE_FP32, dims: [ 1, 3, 9000 ] },
  { name: "detector", data_type: TYPE_FP32, dims: [ 1, 2, 9000 ] }
]
# One CPU-resident copy, one thread: matches the standalone measurement.
instance_group [ { kind: KIND_CPU, count: 1 } ]
parameters { key: "intra_op_thread_count" value: { string_value: "1" } }
parameters { key: "inter_op_thread_count" value: { string_value: "1" } }
